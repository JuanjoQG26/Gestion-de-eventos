    [Inject] private IRepository Repository { get; set; } = null!;
    //private NavigationManager Navegacion { get; set; } = null!;

    private string tipoUsuario = "asistente";
    private string email = "";
    private string password = "";
    private string mensajeError = "";

    private async Task IniciarSesion()
    {
        if (string.IsNullOrEmpty(email) || string.IsNullOrEmpty(password))
        {
            mensajeError = "Porfavor completa todos los campos";
            return;
        }

        try
        {
            var loginDto = new { Email  = email, Contrasena = password};
            var resultado = await Repository.PostAsync("api/usuarios/login", loginDto);

            var usuario = System.Text.Json.JsonSerializer.Deserialize<GestionEventosModelo.Entidades.Usuario>(
                resultado.ToString()!,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
            );

            //mensajeError = usuario?.Rol;
            mensajeError = "";
            await JS.InvokeVoidAsync("sessionStorage.setItem", "usuarioNombre", usuario.Nombre);
            await JS.InvokeVoidAsync("sessionStorage.setItem", "usuarioEmail", usuario.Email);
            await JS.InvokeVoidAsync("sessionStorage.setItem", "usuarioRol", usuario.Rol);
            await JS.InvokeVoidAsync("sessionStorage.setItem", "usuarioId", usuario.Id_Usuario.ToString());
            if (tipoUsuario == "organizador" && usuario?.Rol == "Organizador")
            {
                Navegacion.NavigateTo("/dashboard-organizador");
            }
            else if(tipoUsuario == "asistente" && usuario?.Rol == "Asistente")
            {
                Navegacion.NavigateTo("/dashboard-asistente");
            }
            else
            {
                mensajeError = "Email o contraseña incorrectos";
            }
        }
        catch
        {
            mensajeError = "Email o contraseña incorrectos";
        }
    }

    private void IrARegistro()
    {
        Navegacion.NavigateTo("/registro");
    }
}
