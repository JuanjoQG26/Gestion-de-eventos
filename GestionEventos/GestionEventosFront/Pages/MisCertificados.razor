@* Ruta de esta página *@
@page "/mis-certificados"

@* Permite usar el componente del menú *@
@using GestionEventosFront.Layout
@using GestionEventosModelo

@inject NavigationManager Navegacion
@inject GestionEventosFront.Service.SesionServicio Sesion

@* ===================== HTML - LO QUE SE VE EN PANTALLA ===================== *@

<div class="pagina-con-menu">

    @* ---- MENÚ LATERAL REUTILIZADO ---- *@
    <MenuAsistente />

    @* ---- CONTENIDO PRINCIPAL ---- *@
    <div class="contenido-principal">

        @* ---- BARRA SUPERIOR ---- *@
        <div class="barra-superior">
            <span class="barra-fecha">@fechaHoy</span>
            <div class="barra-usuario">
                <span class="barra-nombre">@nombreUsuario</span>
                <span class="barra-email">@emailUsuario</span>
                <div class="barra-avatar">👤</div>
            </div>
        </div>

        @* ---- CUERPO ---- *@
        <div class="cuerpo-dashboard">

            @* ---- TÍTULO ---- *@
            <h1 class="titulo-pagina">Mis Certificados</h1>
            <p class="subtitulo-pagina">Descarga tus certificados de participación</p>

            @* ---- TARJETAS DE ESTADÍSTICAS ---- *@
            <div class="tarjetas-estadisticas" style="grid-template-columns: repeat(2, 1fr);">
                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-verde">✅</div>
                    <div class="estadistica-numero">
                        @(certificados?.Count(c => !string.IsNullOrEmpty(c.UrlPDF)) ?? 0)
                    </div>
                    <div class="estadistica-texto">Certificados Disponibles</div>
                </div>
                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-naranja">🕐</div>
                    <div class="estadistica-numero">
                        @(certificados?.Count(c => string.IsNullOrEmpty(c.UrlPDF)) ?? 0)
                    </div>
                    <div class="estadistica-texto">En Generación</div>
                </div>
            </div>

            @* ---- BARRA DE BÚSQUEDA ---- *@
            <div class="contenedor-busqueda" style="margin-bottom: 24px;">
                <span class="icono-busqueda">🔍</span>
                <input class="campo-busqueda" type="text"
                       placeholder="Buscar certificados por evento..."
                       @bind="busqueda"
                       @bind:event="oninput" />
            </div>

            @* ---- LISTA DE CERTIFICADOS ---- *@
            @if(certificados == null){
                <p class="subtitulo-pagina">Cargando certificados...</p>
            }
            else if (!certificados.Any())
            {
                <div class="certificados-vacios">
                    <div class="vacios-icono">🏅</div>
                    <h3 class="vacios-titulo">No tienes certificados disponibles</h3>
                    <p class="vacios-desc">
                        Los certificados se generan automáticamente al finalizar tu participación en los eventos
                    </p>
                    <button class="boton-principal" style="width: auto; padding: 12px 24px;"
                            @onclick='() => Navegacion.NavigateTo("/mis-inscripciones")'>
                        Ver Mis Inscripciones
                    </button>
                </div>
            }
            else
            {
            <div class="lista-certificados">
                @foreach (var cert in CertificadosFiltrados)
                {
                    <div class="tarjeta-certificado">

                        <div class="certificado-icono-contenedor">
                            <div class="certificado-icono">🏆</div>
                        </div>

                        <div class="certificado-info">
                            <h3 class="certificado-nombre">Certificado #@cert.Id_Certificado</h3>
                            <div class="certificado-detalles">
                                <span>📅 Generado: @cert.FechaGeneracion.ToString("dd/MM/yyyy")</span>
                                <span>🔑 Código: @cert.CodigoValidacion</span>
                                <span>📋 Inscripción #@cert.Id_Inscripcion</span>
                            </div>
                        </div>

                        <div class="certificado-acciones">
                            @if (!string.IsNullOrEmpty(cert.UrlPDF))
                            {
                                <span class="cert-estado cert-disponible">Disponible</span>
                                <button class="boton-descargar-cert">
                                    📥 Descargar PDF
                                </button>
                            }
                            else
                            {
                                <span class="cert-estado cert-generando">En Generación</span>
                                <p class="cert-mensaje">Disponible pronto</p>
                            }
                        </div>

                    </div>
                }
            </div>
            }

            @* ---- NOTA INFORMATIVA ---- *@
            <div class="nota-informativa" style="margin-top: 32px;">
                <div class="nota-icono">🏆</div>
                <div class="nota-texto">
                    <strong>Sobre tus Certificados</strong>
                    <p>
                        Los certificados se generan automáticamente al finalizar tu participación en un evento.
                        Asegúrate de haber confirmado tu pago y asistido al evento para recibir tu certificado
                        de participación. Puedes descargarlos en formato PDF y compartirlos en tus redes profesionales.
                    </p>
                </div>
            </div>

        </div>
        @* fin cuerpo-dashboard *@

    </div>
    @* fin contenido-principal *@

</div>

@* ===================== C# - LA LÓGICA ===================== *@
@code {
    [Inject] private IRepository Repository { get; set; } = null!;

    // Variable que guarda la fecha de hoy
    private string nombreUsuario = "";
    private string emailUsuario = "";
    private string fechaHoy = "";

    // Variable que guarda lo que el usuario escribe en la búsqueda
    private string busqueda = "";
    private List<Certificado>? certificados;

    private IEnumerable<Certificado> CertificadosFiltrados =>
        (certificados ?? new List<Certificado>())
        .Where(c =>
            string.IsNullOrEmpty(busqueda) ||
            c.CodigoValidacion.Contains(busqueda, StringComparison.OrdinalIgnoreCase));

    // OnInitialized se ejecuta cuando la página carga
    protected override async Task OnInitializedAsync()
    {
        nombreUsuario = await Sesion.ObtenerNombre();
        emailUsuario = await Sesion.ObtenerEmail();
        fechaHoy = DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy",
                   new System.Globalization.CultureInfo("es-ES"));
        await CargarCertificados();
    }

    private async Task CargarCertificados()
    {
        try
        {
            certificados = await Repository.GetAsync<List<Certificado>>("api/certificados");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }
}
