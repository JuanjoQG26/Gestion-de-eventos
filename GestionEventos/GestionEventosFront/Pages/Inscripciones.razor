@* Ruta de esta página *@
@page "/inscripciones"

@* Permite usar el componente del menú *@
@using GestionEventosFront.Layout
@using GestionEventosModelo.Entidades

@inject NavigationManager Navegacion
@inject GestionEventosFront.Service.SesionServicio Sesion

<div class="pagina-con-menu">

    <MenuOrganizador />

    <div class="contenido-principal">

        @* ---- BARRA SUPERIOR ---- *@
        <div class="barra-superior">
            <span class="barra-fecha">@fechaHoy</span>
            <div class="barra-usuario">
                <span class="barra-nombre">@nombreUsuario</span>
                <span class="barra-email">@emailUsuario</span>
                <div class="barra-avatar">👤</div>
            </div>
        </div>

        <div class="cuerpo-dashboard">

            @* ---- ENCABEZADO ---- *@
            <div class="explorar-header">
                <div>
                    <h1 class="titulo-pagina">Inscripciones</h1>
                    <p class="subtitulo-pagina">Gestiona las inscripciones y pagos de los eventos</p>
                </div>
                <button class="boton-exportar">
                    📥 Exportar
                </button>
            </div>

            @* ---- TARJETAS DE ESTADÍSTICAS ---- *@
            <div class="tarjetas-estadisticas" style="grid-template-columns: repeat(3, 1fr);">

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-verde">💲</div>
                    <div class="estadistica-label-pequeño">Ingresos Totales</div>
                    <div class="estadistica-numero">$300</div>
                </div>

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-morado">✅</div>
                    <div class="estadistica-label-pequeño">Pagos Completados</div>
                    <div class="estadistica-numero">2</div>
                </div>

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-naranja">🕐</div>
                    <div class="estadistica-label-pequeño">Pagos Pendientes</div>
                    <div class="estadistica-numero">1</div>
                </div>

            </div>

            @* ---- BARRA DE BÚSQUEDA Y FILTRO ---- *@
            <div class="barra-busqueda-filtros">
                <div class="contenedor-busqueda">
                    <span class="icono-busqueda">🔍</span>
                    <input class="campo-busqueda" type="text"
                           placeholder="Buscar por nombre, email o evento..."
                           @bind="busqueda"
                           @bind:event="oninput" />
                </div>
                @* Select para filtrar por estado *@
                <select class="campo-texto" style="width:auto; padding: 10px 16px;"
                        @bind="filtroEstado">
                    <option value="todos">Todos</option>
                    <option value="Completado">Completado</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="Fallido">Fallido</option>
                </select>
            </div>

            @* ---- TABLA DE INSCRIPCIONES ---- *@
            <h2 class="titulo-seccion">Lista de Inscripciones</h2>
            <div class="tabla-contenedor">
                <table class="tabla-inscripciones">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>ID Usuario</th>
                            <th>Evento</th>
                            <th>Fecha Inscripcion</th>
                            <th>Estado</th>
                            
                        </tr>
                    </thead>
                    <tbody>
                        @if(listaInscripciones == null){
                            <tr><td colspan="5">Cargando inscripciones...</td></tr>
                        }
                        else
                        {
                        @foreach (var ins in InscripcionesFiltradas)
                        {
                            <tr>
                                <td>@ins.Id_Inscripcion</td>
                                <td>@ins.Id_Usuario</td>
                                <td>@ins.Id_Evento</td>
                                <td>@ins.FechaInscripcion.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge-tabla @ObtenerClaseEstado(ins.Estado)">
                                        @ObtenerIconoEstado(ins.Estado) @ins.Estado
                                    </span>
                                </td>
                            </tr>
                        }
                        }
                    </tbody>
                </table>
            </div>

            @if (!InscripcionesFiltradas.Any())
            {
                <div class="sin-resultados">
                    <p>😕 No se encontraron inscripciones.</p>
                </div>
            }

            @* ---- TRAZABILIDAD DE PAGOS ---- *@
            <h2 class="titulo-seccion" style="margin-top:40px;">Trazabilidad de Pagos</h2>
            <div class="lista-trazabilidad">
                @foreach (var ins in (listaInscripciones ?? new List<Inscripcion>()))
                {
                    <div class="tarjeta-trazabilidad">
                        <div class="trazabilidad-icono @ObtenerClaseEstado(ins.Estado)">
                            @ObtenerIconoEstado(ins.Estado)
                        </div>
                        <div class="trazabilidad-info">
                            <span class="trazabilidad-nombre">Inscripcion #@ins.Id_Inscripcion</span>
                            <span class="trazabilidad-detalle">Usuario: @ins.Id_Usuario - Evento: @ins.Id_Evento</span>
                        </div>
                        <div class="trazabilidad-derecha">
                            <span class="trazabilidad-fecha">@ins.FechaInscripcion</span>
                            <span class="trazabilidad-id">ID: @ins.Id_Inscripcion</span>
                        </div>
                    </div>
                }
            </div>

        </div>

    </div>

</div>

@code {
    [Inject] private IRepository Repository { get; set; } = null!;

    private string nombreUsuario = "";
    private string emailUsuario = "";
    private string fechaHoy = "";
    private string busqueda = "";
    private string filtroEstado = "todos";

    private List<Inscripcion>? listaInscripciones;

    private IEnumerable<Inscripcion> InscripcionesFiltradas =>
        (listaInscripciones ?? new List<Inscripcion>())
        .Where(i =>
            (string.IsNullOrEmpty(busqueda) ||
             i.Estado.Contains(busqueda, StringComparison.OrdinalIgnoreCase))
            &&
            (filtroEstado == "todos" || i.Estado == filtroEstado));

    protected override async Task OnInitializedAsync()
    {
        nombreUsuario = await Sesion.ObtenerNombre();
        emailUsuario = await Sesion.ObtenerEmail();
        fechaHoy = DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy",
                   new System.Globalization.CultureInfo("es-ES"));
        await CargarInscripciones();
    }

    private async Task CargarInscripciones()
    {
        try
        {
            listaInscripciones = await Repository.GetAsync<List<Inscripcion>>("api/inscripciones");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            listaInscripciones = new List<Inscripcion>();
        }
    }

    private string ObtenerClaseEstado(string estado)
    {
        return estado switch
        {
            "Confirmada" => "badge-completado-tabla",
            "Pendiente" => "badge-pendiente-tabla",
            "Cancelada" => "badge-fallido-tabla",
            _ => "badge-pendiente-tabla"
        };
    }

    private string ObtenerIconoEstado(string estado)
    {
        return estado switch
        {
            "Confirmada" => "✅",
            "Pendiente" => "🕐",
            "Cancelada" => "❌",
            _ => "🕐"
        };
    }
}
