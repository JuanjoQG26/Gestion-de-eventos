@* Ruta de esta página *@
@page "/dashboard-organizador"

@* Permite usar el componente del menú *@
@using GestionEventosFront.Layout
@using GestionEventosModelo.Entidades

@inject NavigationManager Navegacion
@inject GestionEventosFront.Service.SesionServicio Sesion

<div class="pagina-con-menu">

    @* ---- MENÚ LATERAL ---- *@
    <MenuOrganizador />

    @* ---- CONTENIDO PRINCIPAL ---- *@
    <div class="contenido-principal">

        @* ---- BARRA SUPERIOR ---- *@
        <div class="barra-superior">
            <span class="barra-fecha">@fechaHoy</span>
            <div class="barra-usuario">
                <span class="barra-nombre">@nombreUsuario</span>
                <span class="barra-email">@emailUsuario</span>
                <div class="barra-avatar">👤</div>
            </div>
        </div>

        @* ---- CUERPO ---- *@
        <div class="cuerpo-dashboard">

            <h1 class="titulo-pagina">Dashboard Organizador</h1>

            @* ---- TARJETAS DE ESTADÍSTICAS ---- *@
            <div class="tarjetas-estadisticas">

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-azul">📅</div>
                    <div class="estadistica-numero">@totalEventos</div>
                    <div class="estadistica-texto">Total Eventos</div>
                </div>

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-morado">👥</div>
                    <div class="estadistica-numero">@totalInscripciones</div>
                    <div class="estadistica-texto">Total Inscripciones</div>
                </div>

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-verde">💲</div>
                    <div class="estadistica-numero">$0</div>
                    <div class="estadistica-texto">Ingresos Totales</div>
                </div>

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-naranja">🏆</div>
                    <div class="estadistica-numero">@totalCertificados</div>
                    <div class="estadistica-texto">Certificados Emitidos</div>
                </div>

            </div>

            @* ---- ACCIONES RÁPIDAS ---- *@
            <h2 class="titulo-seccion">Acciones Rápidas</h2>
            <div class="acciones-rapidas">

                <div class="accion-rapida fondo-azul-grad"
                     @onclick='() => NavegaA("/eventos")'>
                    <span class="accion-icono">📅</span>
                    <span class="accion-titulo">Crear Evento</span>
                    <span class="accion-desc">Publicar nuevo evento</span>
                </div>

                <div class="accion-rapida fondo-morado-grad"
                     @onclick='() => NavegaA("/ponentes")'>
                    <span class="accion-icono">👤</span>
                    <span class="accion-titulo">Gestionar Ponentes</span>
                    <span class="accion-desc">Asignar charlas</span>
                </div>

                <div class="accion-rapida fondo-verde-grad"
                     @onclick='() => NavegaA("/inscripciones")'>
                    <span class="accion-icono">💲</span>
                    <span class="accion-titulo">Ver Pagos</span>
                    <span class="accion-desc">Gestionar inscripciones</span>
                </div>

                <div class="accion-rapida fondo-naranja-grad"
                     @onclick='() => NavegaA("/asistencia")'>
                    <span class="accion-icono">✅</span>
                    <span class="accion-titulo">Control Asistencia</span>
                    <span class="accion-desc">Monitorear participantes</span>
                </div>

            </div>

            @* ---- EVENTOS PRÓXIMOS E INSCRIPCIONES RECIENTES ---- *@
            <div class="dashboard-dos-columnas">

                @* ---- COLUMNA IZQUIERDA: EVENTOS PRÓXIMOS ---- *@
                <div class="columna-dashboard">
                    <div class="seccion-header">
                        <h2 class="titulo-seccion">Eventos Próximos</h2>
                        <a class="ver-todos" @onclick='() => NavegaA("/eventos")'>Ver todos →</a>
                    </div>

                    <div class="lista-eventos-org">
                        @if (ultimosEventos == null)
                        {
                            <p class="subtitulo-pagina">Cargando eventos...</p>
                        }
                        else if (!ultimosEventos.Any())
                        {
                            <p class="subtitulo-pagina">No hay eventos registrados</p>
                        }
                        else
                        {
                            @foreach (var evento in ultimosEventos)
                            {
                                <div class="tarjeta-evento-org">
                                    <div class="evento-org-imagen">🎪</div>
                                    <div class="evento-org-info">
                                        <h3 class="evento-org-nombre">@evento.Nombre</h3>
                                        <p class="evento-org-fecha">
                                            @evento.FechaInicio.ToString("dd/MM/yyyy")
                                        </p>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                @* ---- COLUMNA DERECHA: INSCRIPCIONES RECIENTES ---- *@
                <div class="columna-dashboard">
                    <div class="seccion-header">
                        <h2 class="titulo-seccion">Inscripciones Recientes</h2>
                        <a class="ver-todos" @onclick='() => NavegaA("/inscripciones")'>Ver todas →</a>
                    </div>

                    <div class="lista-inscripciones-org">

                        @if (ultimasInscripciones == null)
                        {
                            <p class="subtitulo-pagina">Cargando inscripciones ...</p>
                        }
                        else if (!ultimasInscripciones.Any())
                        {
                            <p class="subtitulo-pagina">No hay inscripciones registradas</p>
                        }
                        else
                        {
                            @foreach (var ins in ultimasInscripciones)
                            {
                                <div class="tarjeta-inscripcion-org">
                                    <div class="inscripcion-org-avatar">👤</div>
                                    <div class="inscripcion-org-info">
                                        <span class="inscripcion-org-nombre">Usuario #@ins.Id_Usuario</span>
                                        <span class="inscripcion-org-evento">Evento #@ins.Id_Evento</span>
                                        <span class="badge-pago @(ins.Estado == "Confirmada" ? "badge-confirmado" : "badge-pendiente")">
                                            @ins.Estado
                                        </span>
                                    </div>
                                </div>
                            }
                        }

                    </div>
                </div>

            </div>

            @* ---- RESUMEN DE PAGOS ---- *@
            <h2 class="titulo-seccion">Resumen de Pagos</h2>
            <div class="resumen-pagos">

                <div class="tarjeta-resumen fondo-verde-suave">
                    <div class="resumen-icono">💲</div>
                    <div class="resumen-info">
                        <span class="resumen-label">Pagos Completados</span>
                        <span class="resumen-numero">2</span>
                        <span class="resumen-sub">$300 en total</span>
                    </div>
                </div>

                <div class="tarjeta-resumen fondo-naranja-suave">
                    <div class="resumen-icono">🕐</div>
                    <div class="resumen-info">
                        <span class="resumen-label">Pagos Pendientes</span>
                        <span class="resumen-numero">1</span>
                        <span class="resumen-sub">$200 esperando confirmación</span>
                    </div>
                </div>

                <div class="tarjeta-resumen fondo-azul-suave">
                    <div class="resumen-icono">📊</div>
                    <div class="resumen-info">
                        <span class="resumen-label">Tasa de Asistencia</span>
                        <span class="resumen-numero">67%</span>
                        <span class="resumen-sub">2 de 3 asistentes</span>
                    </div>
                </div>

            </div>

            @* ---- TAREAS PENDIENTES ---- *@
            <h2 class="titulo-seccion">Tareas Pendientes</h2>
            <div class="lista-tareas">
                <div class="tarea-item">
                    <span class="tarea-icono">⚠️</span>
                    <span>Revisar 1 pagos pendientes de confirmación</span>
                </div>
                <div class="tarea-item">
                    <span class="tarea-icono">⚠️</span>
                    <span>Generar certificados para 1 participantes</span>
                </div>
                <div class="tarea-item">
                    <span class="tarea-icono">⚠️</span>
                    <span>Publicar materiales para eventos completados</span>
                </div>
            </div>

        </div>
        @* fin cuerpo-dashboard *@

    </div>
    @* fin contenido-principal *@

</div>

@code {

    [Inject] private IRepository Repository { get; set; } = null!;

    private string fechaHoy = "";
    private string nombreUsuario = "";
    private string emailUsuario = "";

    private int totalEventos = 0;
    private int totalInscripciones = 0;
    private int totalCertificados = 0;
    private string ingresosTotales = "0";

    private List<GestionEventosModelo.Entidades.Evento>? ultimosEventos;
    private List<GestionEventosModelo.Entidades.Inscripcion>? ultimasInscripciones;

    protected override async Task OnInitializedAsync()
    {
        nombreUsuario = await Sesion.ObtenerNombre();
        emailUsuario = await Sesion.ObtenerEmail();
        fechaHoy = DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy",
                   new System.Globalization.CultureInfo("es-ES"));
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            var eventos = await Repository.GetAsync<List<GestionEventosModelo.Entidades.Evento>>("api/eventos");
            totalEventos = eventos?.Count ?? 0;
            ultimosEventos = eventos?.Take(2).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error eventos {ex.Message}");
            ultimosEventos = new List<GestionEventosModelo.Entidades.Evento>();
        }

        try
        {
            var inscripciones = await Repository.GetAsync<List<GestionEventosModelo.Entidades.Inscripcion>>("api/inscripciones");
            totalInscripciones = inscripciones?.Count ?? 0;
            ultimasInscripciones = inscripciones?.Take(3).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error inscripciones {ex.Message}");
            ultimasInscripciones = new List<GestionEventosModelo.Entidades.Inscripcion>();
        }

        try
        {
            var certificados = await Repository.GetAsync<List<GestionEventosModelo.Entidades.Certificado>>("api/certificados");
            totalCertificados = certificados?.Count ?? 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error certificados: {ex.Message}");
        }
    }

    private void NavegaA(string ruta)
    {
        Navegacion.NavigateTo(ruta);
    }
}   
