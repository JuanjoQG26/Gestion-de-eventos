@* Ruta de esta página *@
@page "/eventos"

@* Permite usar el componente del menú *@
@using GestionEventosFront.Layout
@using GestionEventosModelo.Entidades

@inject NavigationManager Navegacion
@inject GestionEventosFront.Service.SesionServicio Sesion

<div class="pagina-con-menu">

    <MenuOrganizador />

    <div class="contenido-principal">

        @* ---- BARRA SUPERIOR ---- *@
        <div class="barra-superior">
            <span class="barra-fecha">@fechaHoy</span>
            <div class="barra-usuario">
                <span class="barra-nombre">@nombreUsuario</span>
                <span class="barra-email">@emailUsuario</span>
                <div class="barra-avatar">👤</div>
            </div>
        </div>

        <div class="cuerpo-dashboard">

            @* ---- ENCABEZADO CON BOTÓN CREAR ---- *@
            <div class="explorar-header">
                <div>
                    <h1 class="titulo-pagina">Gestión de Eventos</h1>
                    <p class="subtitulo-pagina">Administra y organiza todos tus eventos</p>
                </div>
                @* Botón que muestra el formulario para crear evento *@
                <button class="boton-crear" @onclick="MostrarFormulario">
                    + Crear Evento
                </button>
            </div>

            @* ---- MENSAJE DE ÉXITO ---- *@
            @if (!string.IsNullOrEmpty(mensajeExito))
            {
                <p class="mensaje-exito">@mensajeExito</p>
            }

            @* ---- FORMULARIO CREAR EVENTO (se muestra solo si mostrarFormulario es true) ---- *@
            @if (mostrarFormulario)
            {
                <div class="formulario-card">
                    <h2 class="formulario-titulo">
                        @(eventoEditando ? "Editar Evento" : "Crear Nuevo Evento")
                    </h2>

                    <div class="formulario-grid">

                        <div class="grupo-campo">
                            <label class="etiqueta">Nombre del Evento</label>
                            <input class="campo-texto" type="text"
                                   placeholder="Ej: Congreso de Tecnología 2026"
                                   @bind="nuevoNombre" />
                        </div>

                        <div class="grupo-campo">
                            <label class="etiqueta">Lugar</label>
                            <input class="campo-texto" type="text"
                                   placeholder="Ej: Centro de Convenciones"
                                   @bind="nuevoLugar" />
                        </div>

                        <div class="grupo-campo">
                            <label class="etiqueta">Fecha Inicio</label>
                            <input class="campo-texto" type="datetime-local"
                                   @bind="nuevaFechaInicio" />
                        </div>

                        <div class="grupo-campo">
                            <label class="etiqueta">Fecha Fin</label>
                            <input class="campo-texto" type="datetime-local"
                                   @bind="nuevaFechaFin" />
                        </div>

                        <div class="grupo-campo">
                            <label class="etiqueta">Precio</label>
                            <input class="campo-texto" type="number"
                                   placeholder="0"
                                   @bind="nuevoPrecio" />
                        </div>

                        <div class="grupo-campo">
                            <label class="etiqueta">Cupo Total</label>
                            <input class="campo-texto" type="number"
                                   placeholder="100"
                                   @bind="nuevoCupo" />
                        </div>

                    </div>

                    <div class="grupo-campo">
                        <label class="etiqueta">Descripción</label>
                        <textarea class="campo-texto campo-textarea"
                                  placeholder="Describe el evento..."
                                  @bind="nuevaDescripcion"></textarea>
                    </div>

                    @* Mensaje de error si campos vacíos *@
                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <p class="mensaje-error">@mensajeError</p>
                    }

                    <div class="formulario-botones">
                        <button class="boton-principal" style="width:auto; padding: 12px 32px;"
                                @onclick="GuardarEvento">
                            @(eventoEditando ? "Guardar Cambios" : "Guardar Evento")
                        </button>
                        <button class="boton-cancelar" @onclick="CancelarFormulario">
                            Cancelar
                        </button>
                    </div>

                </div>
            }

            @* ---- BARRA DE BÚSQUEDA Y FILTROS ---- *@
            <div class="barra-busqueda-filtros">
                <div class="contenedor-busqueda">
                    <span class="icono-busqueda">🔍</span>
                    <input class="campo-busqueda" type="text"
                           placeholder="Buscar eventos..."
                           @bind="busqueda"
                           @bind:event="oninput" />
                </div>
                <div class="botones-filtro">
                    <button class="boton-filtro @(filtroActivo == "todos" ? "filtro-activo" : "")"
                            @onclick='() => filtroActivo = "todos"'>
                        Todos
                    </button>
                    <button class="boton-filtro @(filtroActivo == "proximo" ? "filtro-activo" : "")"
                            @onclick='() => filtroActivo = "proximo"'>
                        Próximos
                    </button>
                    <button class="boton-filtro @(filtroActivo == "en curso" ? "filtro-activo" : "")"
                            @onclick='() => filtroActivo = "en curso"'>
                        En Curso
                    </button>
                    <button class="boton-filtro @(filtroActivo == "completado" ? "filtro-activo" : "")"
                            @onclick='() => filtroActivo = "completado"'>
                        Completados
                    </button>
                </div>
            </div>

            @* ---- GRID DE EVENTOS ---- *@
            <div class="grid-eventos">
                @foreach (var evento in EventosFiltrados)
                {
                    <div class="tarjeta-evento-explorar">

                        <div class="evento-imagen-contenedor">
                            <div class="evento-imagen-placeholder">🎪</div>
                            <span class="badge-estado @evento.Estado">@evento.Estado</span>
                        </div>

                        <div class="evento-explorar-info">
                            <h3 class="evento-explorar-nombre">@evento.Nombre</h3>
                            <p class="evento-explorar-desc">@evento.Descripcion</p>

                            <div class="evento-explorar-detalles">
                                <span>📅 @evento.FechaInicio</span>
                                <span>📍 @evento.Lugar</span>
                                <span>👥 @evento.CupoTotal / @evento.CupoTotal inscritos</span>
                                <span class="evento-precio">💲 $@evento.Precio</span>
                            </div>

                            @*<div class="barra-ocupacion-contenedor">
                                <span class="ocupacion-texto">Ocupación</span>
                                <span class="ocupacion-porcentaje">@evento.Ocupacion%</span>
                            </div>*@
                            @*<div class="barra-ocupacion">*@
                                @*<div class="barra-ocupacion-progreso"
                                     style="width: @evento.Ocupacion%"></div>
                            </div>*@

                            @* Botones de acción del organizador *@
                            <div class="evento-acciones-org">
                                <button class="boton-editar-evento"
                                        @onclick="() => EditarEvento(evento)">
                                    ✏️ Editar
                                </button>
                                <button class="boton-eliminar-evento"
                                        @onclick="() => EliminarEvento(evento)">
                                    🗑️ Eliminar
                                </button>
                            </div>

                        </div>
                    </div>
                }
            </div>

            @if (!EventosFiltrados.Any())
            {
                <div class="sin-resultados">
                    <p>😕 No se encontraron eventos.</p>
                </div>
            }

        </div>

    </div>

</div>

@code {

    [Inject] private IRepository Repository { get; set; } = null!;

    private string nombreUsuario = "";
    private string emailUsuario = "";
    private int idOrganizador = 0;

    private string fechaHoy = "";
    private string busqueda = "";
    private string filtroActivo = "todos";
    private bool mostrarFormulario = false;
    private bool eventoEditando = false;
    private string mensajeError = "";
    private string mensajeExito = "";
    private List<GestionEventosModelo.Entidades.Evento>? listaEventos;

    // Variables del formulario
    private string nuevoNombre = "";
    private string nuevaDescripcion = "";
    private string nuevoLugar = "";
    private DateTime nuevaFechaInicio = DateTime.Now.AddDays(1);
    private DateTime nuevaFechaFin = DateTime.Now.AddDays(1).AddHours(2);
    private decimal nuevoPrecio = 0;
    private int nuevoCupo = 0;
    private int eventoEditandoId = 0;



    private IEnumerable<Evento> EventosFiltrados => (listaEventos ?? new List<Evento>())
        .Where(e =>
            (string.IsNullOrEmpty(busqueda) ||
             e.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
             e.Lugar.Contains(busqueda, StringComparison.OrdinalIgnoreCase))
            &&
            (filtroActivo == "todos" ||
             e.Estado.ToLower() == filtroActivo));

    protected override async Task OnInitializedAsync()
    {
        idOrganizador = await Sesion.ObtenerId();
        nombreUsuario = await Sesion.ObtenerNombre();
        emailUsuario = await Sesion.ObtenerEmail();
        fechaHoy = DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy",
                   new System.Globalization.CultureInfo("es-ES"));
        await CargarEventos();
    }

    private async Task CargarEventos()
    {
        try
        {
            listaEventos = await Repository.GetAsync<List<Evento>>
            ($"api/eventos/organizador/{idOrganizador}");
        }
        catch
        {
            listaEventos = new List<Evento>();
        }
    }

    private void MostrarFormulario()
    {
        // Limpia el formulario y lo muestra
        eventoEditando = false;
        nuevoNombre = "";
        nuevaDescripcion = "";
        nuevoLugar = "";
        nuevaFechaInicio = DateTime.Now;
        nuevaFechaFin = DateTime.Now.AddHours(2);
        nuevoPrecio = 0;
        nuevoCupo = 0;
        mensajeError = "";
        mostrarFormulario = true;
    }

    private async Task GuardarEvento()
    {
        // Valida que los campos obligatorios estén llenos
        if (string.IsNullOrEmpty(nuevoNombre) || string.IsNullOrEmpty(nuevoLugar) ||
            string.IsNullOrEmpty(nuevaDescripcion) || nuevoCupo <= 0)
        {
            mensajeError = "Por favor completa todos los campos obligatorios.";
            return;
        }

        try
        {
            var evento = new Evento
                {
                    
                    Nombre = nuevoNombre,
                    Descripcion = nuevaDescripcion,

                    FechaInicio = nuevaFechaInicio,
                    FechaFin = nuevaFechaFin,
                    Lugar = nuevoLugar,
                    Precio = nuevoPrecio,
                    CupoTotal = nuevoCupo,
                    Estado = "Borrador",
                    Id_Organizador = idOrganizador
                };


            if (eventoEditando)
            {
                await Repository.PutAsync($"api/eventos/{eventoEditandoId}", evento);
            }
            else
            {
                await Repository.PostAsync("api/eventos", evento);
            }

            mensajeExito = eventoEditando ? "EventoActualizado" : "EventoCreado";
            mostrarFormulario = false;
            mensajeError = "";
            await CargarEventos();
        }
        catch(Exception ex)
        {
            mensajeError = $"Error: {ex.Message}"; 
        }
    }

    private void EditarEvento(Evento evento)
    {
        // Carga los datos del evento en el formulario
        eventoEditando = true;
        eventoEditandoId = evento.Id_Evento;
        nuevoNombre = evento.Nombre;
        nuevaDescripcion = evento.Descripcion;
        nuevoLugar = evento.Lugar;
        nuevoPrecio = evento.Precio;
        nuevoCupo = evento.CupoTotal;
        mensajeError = "";
        mostrarFormulario = true;
    }

    private async Task EliminarEvento(Evento evento)
    {
        try
        {
            await Repository.DeleteAsync($"api/eventos/{evento.Id_Evento}");
            mensajeExito = "Evento eliminado";
            await CargarEventos();
        }
        catch
        {
            mensajeError = "No se puede eliminar este evento";
        }
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        mensajeError = "";
    }

    private void NavegaA(string ruta)
    {
        Navegacion.NavigateTo(ruta);
    }
}