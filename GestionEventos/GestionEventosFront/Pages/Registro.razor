    [Inject] private IRepository Repository { get; set; } = null!;

    private string tipoUsuario = "asistente";
    private string nombre = "";
    private string email = "";
    private string telefono = "";
    private string password = "";
    private string mensajeError = "";
    private string mensajeExito = "";

    private async Task Registrarse()
    {
        if (string.IsNullOrEmpty(nombre) || string.IsNullOrEmpty(email) || string.IsNullOrEmpty(password))
        {
            mensajeError = "Por favor completa todos los campos";
            return;
        }

        if (password.Length < 6)
        {
            mensajeError = "La contraseña debe tener al menos 6 caracteres";
            return;
        }

        try
        {
            var usuario = new Usuario
            {
                Nombre = nombre,
                Email = email,
                Contrasena = password,
                Rol = tipoUsuario == "organizador"? "Organizador": "Asistente",
                FechaRegistro = DateTime.Now
            };

            await Repository.PostAsync("api/usuarios/registro", usuario);
            mensajeExito = "¡Registro exitoso! Redirigiendo...";
            mensajeError = "";
            Navegacion.NavigateTo("/");
        }
        catch
        {
            mensajeError = "El email ya esta registrado";
        }
    }

    private void IrALogin()
    {
        Navegacion.NavigateTo("/");
    }
}
