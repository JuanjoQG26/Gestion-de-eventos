@* Ruta de esta página: cuando el usuario vaya a "/registro" se muestra esta página *@
@page "/registro"

@* Permite navegar entre páginas *@
@inject NavigationManager Navegacion

@* ===================== HTML - LO QUE SE VE EN PANTALLA ===================== *@

@* DIV que cubre toda la pantalla con el fondo degradado *@
<div class="fondo-login">

    @* DIV que agrupa y centra todo el contenido *@
    <div class="contenedor-login">

        @* ---- ENCABEZADO: ícono + título ---- *@
        <div class="encabezado">
            <div class="icono-logo">📅</div>
            <h1 class="titulo-logo">Gestión de Eventos</h1>
        </div>

        @* ---- TARJETA BLANCA DEL FORMULARIO ---- *@
        <div class="tarjeta">

            <h2 class="titulo-tarjeta">Registrarse</h2>
            <p class="subtitulo-tarjeta">Crea tu cuenta en la plataforma</p>

            @* ---- SELECTOR TIPO DE USUARIO ---- *@
            <label class="etiqueta">Registrarse como</label>
            <div class="botones-tipo">

                @* Si tipoUsuario es "asistente" le agrega la clase "seleccionado" *@
                <button class="boton-tipo @(tipoUsuario == "asistente" ? "seleccionado" : "")"
                        @onclick='() => tipoUsuario = "asistente"'>
                    <span>👤</span>
                    <span>Asistente</span>
                </button>

                <button class="boton-tipo @(tipoUsuario == "organizador" ? "seleccionado" : "")"
                        @onclick='() => tipoUsuario = "organizador"'>
                    <span>👥</span>
                    <span>Organizador</span>
                </button>

            </div>

            @* ---- CAMPO NOMBRE COMPLETO ---- *@
            <div class="grupo-campo">
                <label class="etiqueta">Nombre Completo</label>
                @* @bind="nombre" conecta este input con la variable nombre del código C# *@
                <input class="campo-texto" type="text" placeholder="Juan Pérez" @bind="nombre" />
            </div>

            @* ---- CAMPO EMAIL ---- *@
            <div class="grupo-campo">
                <label class="etiqueta">Email</label>
                <input class="campo-texto" type="email" placeholder="tu@email.com" @bind="email" />
            </div>

            @* ---- CAMPO TELÉFONO ---- *@
            <div class="grupo-campo">
                <label class="etiqueta">Teléfono</label>
                <input class="campo-texto" type="tel" placeholder="+57 300 123 4567" @bind="telefono" />
            </div>

            @* ---- CAMPO CONTRASEÑA ---- *@
            <div class="grupo-campo">
                <label class="etiqueta">Contraseña</label>
                <input class="campo-texto" type="password" placeholder="••••••••" @bind="password" />
            </div>

            @* ---- MENSAJE DE ERROR: solo aparece si mensajeError tiene texto ---- *@
            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <p class="mensaje-error">@mensajeError</p>
            }

            @* ---- MENSAJE DE ÉXITO: solo aparece si mensajeExito tiene texto ---- *@
            @if (!string.IsNullOrEmpty(mensajeExito))
            {
                <p class="mensaje-exito">@mensajeExito</p>
            }

            @* ---- BOTÓN REGISTRARSE ---- *@
            <button class="boton-principal" @onclick="Registrarse">Registrarse</button>

            @* ---- ENLACE AL LOGIN ---- *@
            <p class="enlace-registro">
                ¿Ya tienes cuenta? <a @onclick="IrALogin">Inicia sesión</a>
            </p>

        </div>

        @* ---- PIE DE PÁGINA INFORMATIVO ---- *@
        <div class="pie-pagina">
            <p><strong>Asistente:</strong> Inscríbete a eventos, descarga materiales y certificados</p>
            <p><strong>Organizador:</strong> Crea eventos, gestiona ponentes y genera reportes</p>
        </div>

    </div>
</div>

