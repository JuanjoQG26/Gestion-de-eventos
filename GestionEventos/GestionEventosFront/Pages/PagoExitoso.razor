@page "/pago-exitoso"
@inject NavigationManager Navegacion

<div class="fondo-login">
    <div class="contenedor-login">
        <div class="tarjeta" style="text-align:center; padding: 60px 40px;">
            <div style="font-size: 4rem;">✅</div>
            <h2 class="titulo-tarjeta" style="margin-top:16px;">Pago Exitoso!</h2>
            <p class="subtitulo-tarjeta">Tu inscripción ha sido confirmada correctamente</p>
            <button class="boton-principal" style="width:auto; padding: 12px 32px; margin-top: 24px;"
            @onclick='() => Navegacion.NavigateTo("/mis-inscripciones")'>
                Ver mis inscripciones
            </button>
        </div>
    </div>
</div>

