@* Ruta de esta página *@
@page "/certificados"

@* Permite usar el componente del menú *@
@using GestionEventosFront.Layout
@using GestionEventosModelo.Entidades

@inject NavigationManager Navegacion
@inject GestionEventosFront.Service.SesionServicio Sesion

<div class="pagina-con-menu">

    <MenuOrganizador />

    <div class="contenido-principal">

        @* ---- BARRA SUPERIOR ---- *@
        <div class="barra-superior">
            <span class="barra-fecha">@fechaHoy</span>
            <div class="barra-usuario">
                <span class="barra-nombre">@nombreUsuario</span>
                <span class="barra-email">@emailUsuario</span>
                <div class="barra-avatar">👤</div>
            </div>
        </div>

        <div class="cuerpo-dashboard">

            @* ---- ENCABEZADO ---- *@
            <div class="explorar-header">
                <div>
                    <h1 class="titulo-pagina">Certificados</h1>
                    <p class="subtitulo-pagina">Genera y distribuye certificados de participación</p>
                </div>
                <button class="boton-crear" @onclick="GenerarCertificados">
                    🏆 Generar Certificado
                </button>
            </div>

            @* ---- MENSAJE ÉXITO ---- *@
            @if (!string.IsNullOrEmpty(mensajeExito))
            {
                <p class="mensaje-exito">@mensajeExito</p>
            }

            @* ---- TARJETAS DE ESTADÍSTICAS ---- *@
            <div class="tarjetas-estadisticas" style="grid-template-columns: repeat(3, 1fr);">

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-verde">✅</div>
                    <div class="estadistica-label-pequeño">Generados</div>
                    <div class="estadistica-numero">
                        @(listaCertificados?.Count(c => !string.IsNullOrEmpty(c.UrlPDF)) ?? 0)
                    </div>
                </div>

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-azul">📤</div>
                    <div class="estadistica-label-pequeño">Enviados</div>
                    <div class="estadistica-numero">
                        @(listaCertificados?.Count(c => !string.IsNullOrEmpty(c.UrlPDF)) ?? 0)
                    </div>
                </div>

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-naranja">🕐</div>
                    <div class="estadistica-label-pequeño">Pendientes</div>
                    <div class="estadistica-numero">
                        @(listaCertificados?.Count(c => string.IsNullOrEmpty(c.UrlPDF)) ?? 0)
                    </div>
                </div>

            </div>

            @* ---- LISTA DE CERTIFICADOS ---- *@
            <div class="tabla-contenedor">

                <div style="display:flex; justify-content:space-between; align-items:center; padding: 16px 20px; border-bottom: 1px solid #e5e7eb;">
                    <span class="tabla-titulo-seccion" style="padding:0; border:none;">Lista de Certificados</span>
                    <button class="boton-crear" style="padding: 8px 20px; font-size:0.85rem;"
                            @onclick="EnviarTodos">
                        📤 Enviar Todos
                    </button>
                </div>

                @* Barra de búsqueda dentro de la tarjeta *@
                <div style="padding: 16px 20px; border-bottom: 1px solid #f3f4f6;">
                    <div class="contenedor-busqueda">
                        <span class="icono-busqueda">🔍</span>
                        <input class="campo-busqueda" type="text"
                               placeholder="Buscar por nombre o email..."
                               @bind="busqueda"
                               @bind:event="oninput" />
                    </div>
                </div>

                <table class="tabla-inscripciones">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>ID Inscripcion</th>
                            <th>Fecha Generacion</th>
                            <th>Codigo Validación</th>
                            <th>Url PDF</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (listaCertificados == null)
                        {
                            <tr><td colspan="6">Cargando certificados ...</td></tr>
                        }
                        else if (!listaCertificados.Any())
                        {
                            <tr><td colpsan="6" style="text-align:center;">No hay certificados registrados</td></tr>

                        }
                        else
                        {
                            @foreach (var cert in CertificadosFiltrados)
                            {
                                <tr>
                                    <td>@cert.Id_Certificado</td>
                                    <td>@cert.Id_Inscripcion</td>
                                    <td>@cert.FechaGeneracion.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge-tabla badge-generado-tabla">
                                            @cert.CodigoValidacion
                                        </span>
                                    </td>
                                    <td>
                                        @if (string.IsNullOrEmpty(cert.UrlPDF))
                                        {
                                            <span class="badge-table badge-pendiente-tabla">🕐 Pendiente</span>
                                        }
                                        else
                                        {
                                            <span class="badge-table badge-completado-tabla">✅ Disponible</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="boton-enviar-cert" @onclick="() => EnviarCertificado(cert)">
                                            📤 Enviar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>

            @if (!CertificadosFiltrados.Any())
            {
                <div class="sin-resultados">
                    <p>😕 No se encontraron certificados.</p>
                </div>
            }

        </div>

    </div>

</div>

@code {
    [Inject] private IRepository Repository { get; set; } = null!;

    private string nombreUsuario = "";
    private string emailUsuario = "";

    private string fechaHoy = "";
    private string busqueda = "";
    private string mensajeExito = "";

    private List<Certificado>? listaCertificados;



    private IEnumerable<Certificado> CertificadosFiltrados => (listaCertificados ?? new List<Certificado>())
        .Where(c =>
            string.IsNullOrEmpty(busqueda) ||
            c.CodigoValidacion.Contains(busqueda, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        nombreUsuario = await Sesion.ObtenerNombre();
        emailUsuario = await Sesion.ObtenerEmail();
        fechaHoy = DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy",
                   new System.Globalization.CultureInfo("es-ES"));

        await CargarCertificados();
    }

    private async Task CargarCertificados()
    {
        try
        {
            listaCertificados = await Repository.GetAsync<List<Certificado>>("api/certificados");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            listaCertificados = new List<Certificado>();
        }
    }

    private void GenerarCertificados()
    {
        mensajeExito = "Certificados generados exitosamente.";
    }

    private async Task EnviarCertificado(Certificado cert)
    {
        try
        {
            // Actualiza el certificado con la URL del PDF
            cert.UrlPDF = $"certificados/{cert.Id_Certificado}.pdf";
            await Repository.PutAsync($"api/certificados/{cert.Id_Certificado}", cert);
            mensajeExito = $"Certificado #{cert.Id_Certificado} enviado correctamente";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task EnviarTodos()
    {
        try
        {
            /*for (int i = 0; i < (listaCertificados?.Count ?? 0); i++)
            {
                var cert = listaCertificados[i];
                cert.UrlPDF = $"certificados/{cert.Id_Certificado}.pdf";
                await Repository.PutAsync($"api/certificados/{cert.Id_Certificado}", cert);
                }*/


        foreach (var cert in listaCertificados ?? new List<Certificado>())
            {
                cert.UrlPDF = $"certificados/{cert.Id_Certificado}.pdf";
                await Repository.PutAsync($"api/certificados/{cert.Id_Certificado}", cert);
            }

            mensajeExito = "Todos los certificados fueron enviados exitosamente";
            await CargarCertificados();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }
}