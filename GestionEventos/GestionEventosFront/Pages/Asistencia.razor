@* Ruta de esta página *@
@page "/asistencia"

@* Permite usar el componente del menú *@
@using GestionEventosFront.Layout

@inject NavigationManager Navegacion

<div class="pagina-con-menu">

    <MenuOrganizador />

    <div class="contenido-principal">

        @* ---- BARRA SUPERIOR ---- *@
        <div class="barra-superior">
            <span class="barra-fecha">@fechaHoy</span>
            <div class="barra-usuario">
                <span class="barra-nombre">Luis</span>
                <span class="barra-email">luis@gmail.com</span>
                <div class="barra-avatar">👤</div>
            </div>
        </div>

        <div class="cuerpo-dashboard">

            @* ---- ENCABEZADO ---- *@
            <div class="explorar-header">
                <div>
                    <h1 class="titulo-pagina">Control de Asistencia</h1>
                    <p class="subtitulo-pagina">Monitorea la asistencia y participación en tiempo real</p>
                </div>
                <div style="display:flex; gap:12px;">
                    <button class="boton-asignar">
                        📱 Escanear QR
                    </button>
                    <button class="boton-exportar">
                        📥 Exportar
                    </button>
                </div>
            </div>

            @* ---- TARJETAS DE ESTADÍSTICAS ---- *@
            <div class="tarjetas-estadisticas" style="grid-template-columns: repeat(3, 1fr);">

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-morado">👥</div>
                    <div class="estadistica-label-pequeño">Tasa de Asistencia</div>
                    <div class="estadistica-numero">66.7%</div>
                </div>

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-verde">✅</div>
                    <div class="estadistica-label-pequeño">Presentes</div>
                    <div class="estadistica-numero">2</div>
                </div>

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-naranja">❌</div>
                    <div class="estadistica-label-pequeño">Ausentes</div>
                    <div class="estadistica-numero">1</div>
                </div>

            </div>

            @* ---- BARRA DE BÚSQUEDA Y FILTROS ---- *@
            <div class="barra-busqueda-filtros">
                <div class="contenedor-busqueda">
                    <span class="icono-busqueda">🔍</span>
                    <input class="campo-busqueda" type="text"
                           placeholder="Buscar participante o evento..."
                           @bind="busqueda"
                           @bind:event="oninput" />
                </div>
                <select class="campo-texto" style="width:auto; padding: 10px 16px;"
                        @bind="filtroEvento">
                    <option value="todos">Todos los eventos</option>
                    <option value="Cumbre de Innovación Digital">Cumbre de Innovación Digital</option>
                    <option value="Conferencia de Tecnología 2026">Conferencia de Tecnología 2026</option>
                </select>
                <select class="campo-texto" style="width:auto; padding: 10px 16px;"
                        @bind="filtroEstado">
                    <option value="todos">Todos</option>
                    <option value="Presente">Presente</option>
                    <option value="Ausente">Ausente</option>
                </select>
            </div>

            @* ---- TABLA DE ASISTENCIA ---- *@
            <div class="tabla-contenedor">
                <div class="tabla-titulo-seccion">Registro de Asistencia</div>
                <table class="tabla-inscripciones">
                    <thead>
                        <tr>
                            <th>Participante</th>
                            <th>Evento</th>
                            <th>Check-in</th>
                            <th>Check-out</th>
                            <th>Estado</th>
                            <th>Actividades</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var asistencia in AsistenciasFiltradas)
                        {
                            <tr>
                                <td>
                                    <span class="tabla-nombre">@asistencia.Nombre</span>
                                </td>
                                <td>@asistencia.Evento</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(asistencia.CheckIn))
                                    {
                                        <div class="asistencia-tiempo">
                                            <span>@asistencia.CheckIn</span>
                                            <span class="tiempo-hora">@asistencia.HoraIn</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="sin-dato">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(asistencia.CheckOut))
                                    {
                                        <div class="asistencia-tiempo">
                                            <span>@asistencia.CheckOut</span>
                                            <span class="tiempo-hora">@asistencia.HoraOut</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="sin-dato">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge-tabla @(asistencia.Estado == "Presente" ? "badge-completado-tabla" : "badge-fallido-tabla")">
                                        @asistencia.Estado
                                    </span>
                                </td>
                                <td>
                                    <span class="badge-actividades">
                                        @asistencia.ActividadesCompletadas/@asistencia.TotalActividades completadas
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!AsistenciasFiltradas.Any())
            {
                <div class="sin-resultados">
                    <p>😕 No se encontraron registros.</p>
                </div>
            }

            @* ---- SELECCIÓN DE ACTIVIDADES ---- *@
            <div class="tabla-contenedor" style="padding: 24px;">
                <div class="tabla-titulo-seccion">Selección de Actividades</div>
                @foreach (var asistencia in listaAsistencias)
                {
                    <div class="asistencia-actividades-grupo">
                        <h3 class="asistencia-grupo-titulo">
                            @asistencia.Nombre - @asistencia.Evento
                        </h3>
                        @foreach (var actividad in asistencia.Actividades)
                        {
                            <div class="asistencia-actividad-item">
                                @actividad
                            </div>
                        }
                    </div>
                }
            </div>

        </div>

    </div>

</div>

@code {

    private string fechaHoy = "";
    private string busqueda = "";
    private string filtroEvento = "todos";
    private string filtroEstado = "todos";

    private class AsistenciaItem
    {
        public string Nombre { get; set; } = "";
        public string Evento { get; set; } = "";
        public string CheckIn { get; set; } = "";
        public string HoraIn { get; set; } = "";
        public string CheckOut { get; set; } = "";
        public string HoraOut { get; set; } = "";
        public string Estado { get; set; } = "";
        public int ActividadesCompletadas { get; set; }
        public int TotalActividades { get; set; }
        public List<string> Actividades { get; set; } = new();
    }

    private List<AsistenciaItem> listaAsistencias = new List<AsistenciaItem>
    {
        new AsistenciaItem
        {
            Nombre = "María González",
            Evento = "Cumbre de Innovación Digital",
            CheckIn = "10/3/2026", HoraIn = "08:45",
            CheckOut = "10/3/2026", HoraOut = "18:30",
            Estado = "Presente",
            ActividadesCompletadas = 2, TotalActividades = 2,
            Actividades = new List<string> { "Sesión Inaugural", "Panel de Expertos" }
        },
        new AsistenciaItem
        {
            Nombre = "Juan Pérez",
            Evento = "Cumbre de Innovación Digital",
            CheckIn = "10/3/2026", HoraIn = "09:15",
            CheckOut = "", HoraOut = "",
            Estado = "Presente",
            ActividadesCompletadas = 1, TotalActividades = 2,
            Actividades = new List<string> { "Sesión Inaugural", "Panel de Expertos" }
        },
        new AsistenciaItem
        {
            Nombre = "Laura Martín",
            Evento = "Cumbre de Innovación Digital",
            CheckIn = "", HoraIn = "",
            CheckOut = "", HoraOut = "",
            Estado = "Ausente",
            ActividadesCompletadas = 0, TotalActividades = 0,
            Actividades = new List<string>()
        },
    };

    private IEnumerable<AsistenciaItem> AsistenciasFiltradas => listaAsistencias
        .Where(a =>
            (string.IsNullOrEmpty(busqueda) ||
             a.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
             a.Evento.Contains(busqueda, StringComparison.OrdinalIgnoreCase))
            &&
            (filtroEvento == "todos" || a.Evento == filtroEvento)
            &&
            (filtroEstado == "todos" || a.Estado == filtroEstado));

    protected override void OnInitialized()
    {
        fechaHoy = DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy",
                   new System.Globalization.CultureInfo("es-ES"));
    }
}
