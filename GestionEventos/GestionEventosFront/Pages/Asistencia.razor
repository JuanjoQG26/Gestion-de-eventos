@* Ruta de esta página *@
@page "/asistencia"

@* Permite usar el componente del menú *@
@using GestionEventosFront.Layout
@using GestionEventosModelo.Entidades


@inject NavigationManager Navegacion

<div class="pagina-con-menu">

    <MenuOrganizador />

    <div class="contenido-principal">

        @* ---- BARRA SUPERIOR ---- *@
        <div class="barra-superior">
            <span class="barra-fecha">@fechaHoy</span>
            <div class="barra-usuario">
                <span class="barra-nombre">Luis</span>
                <span class="barra-email">luis@gmail.com</span>
                <div class="barra-avatar">👤</div>
            </div>
        </div>

        <div class="cuerpo-dashboard">

            @* ---- ENCABEZADO ---- *@
            <div class="explorar-header">
                <div>
                    <h1 class="titulo-pagina">Control de Asistencia</h1>
                    <p class="subtitulo-pagina">Monitorea la asistencia y participación en tiempo real</p>
                </div>
                <div style="display:flex; gap:12px;">
                    <button class="boton-asignar">
                        📱 Escanear QR
                    </button>
                    <button class="boton-exportar">
                        📥 Exportar
                    </button>
                </div>
            </div>

            @* ---- TARJETAS DE ESTADÍSTICAS ---- *@
            <div class="tarjetas-estadisticas" style="grid-template-columns: repeat(3, 1fr);">

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-morado">👥</div>
                    <div class="estadistica-label-pequeño">@TasaAsistencia</div>
                    <div class="estadistica-numero">66.7%</div>
                </div>

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-verde">✅</div>
                    <div class="estadistica-label-pequeño">@TotalPresentes</div>
                    <div class="estadistica-numero">2</div>
                </div>

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-naranja">❌</div>
                    <div class="estadistica-label-pequeño">@TotalAusentes</div>
                    <div class="estadistica-numero">1</div>
                </div>

            </div>

            @* ---- BARRA DE BÚSQUEDA Y FILTROS ---- *@
            <div class="barra-busqueda-filtros">
                <div class="contenedor-busqueda">
                    <span class="icono-busqueda">🔍</span>
                    <input class="campo-busqueda" type="text"
                           placeholder="Buscar participante o evento..."
                           @bind="busqueda"
                           @bind:event="oninput" />
                </div>
                <select class="campo-texto" style="width:auto; padding: 10px 16px;"
                        @bind="filtroEvento">
                    <option value="todos">Todos los eventos</option>
                    <option value="Cumbre de Innovación Digital">Cumbre de Innovación Digital</option>
                    <option value="Conferencia de Tecnología 2026">Conferencia de Tecnología 2026</option>
                </select>
                <select class="campo-texto" style="width:auto; padding: 10px 16px;"
                        @bind="filtroEstado">
                    <option value="todos">Todos</option>
                    <option value="Presente">Presente</option>
                    <option value="Ausente">Ausente</option>
                </select>
            </div>

            @* ---- TABLA DE ASISTENCIA ---- *@
            <div class="tabla-contenedor">
                <div class="tabla-titulo-seccion">Registro de Asistencia</div>
                <table class="tabla-inscripciones">
                    <thead>
                        <tr>
                            <th>Id Asistencia</th>
                            <th>Id Inscripcion</th>
                            <th>Id Actividad</th>
                            <th>Fecha Registro</th>
                            <th>Metodo</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (listaAsistencias == null)
                        {
                            <tr><td colspan="6">Cargando asistencias ...</td></tr>
                        }
                        else if (!listaAsistencias.Any())
                        {
                            <tr>
                                <td colspan="6" style="text-align:center">
                                    No hay registros de asistencia
                                </td>
                            </tr>
                        }
                        else{
                        @foreach (var asistencia in AsistenciasFiltradas)
                        {
                            <tr>
                                <td>@asistencia.Id_Asistencia</td>
                                <td>@asistencia.Id_Inscripcion</td>
                                <td>@asistencia.Id_Actividad</td>
                                <td>@asistencia.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@asistencia.MetodoRegistro</td>
                                <td>
                                    <span class="badge-tabla @ObtenerClaseEstado(asistencia)">
                                        @ObtenerEstado(asistencia)
                                    </span>
                                </td>
                            </tr>
                        }
                        }
                    </tbody>
                </table>
            </div>

            @if (!AsistenciasFiltradas.Any())
            {
                <div class="sin-resultados">
                    <p>😕 No se encontraron registros.</p>
                </div>
            }

            

        </div>

    </div>

</div>

@code {
    [Inject] private IRepository Repository { get; set; } = null!;


    private string fechaHoy = "";
    private string busqueda = "";
    private string filtroEvento = "todos";
    private string filtroEstado = "todos";

    private List<GestionEventosModelo.Entidades.Asistencia>? listaAsistencias;

    private IEnumerable<GestionEventosModelo.Entidades.Asistencia> AsistenciasFiltradas =>
        (listaAsistencias ?? new List<GestionEventosModelo.Entidades.Asistencia>())
        .Where(a =>
            (string.IsNullOrEmpty(busqueda) ||
             a.Id_Inscripcion.ToString().Contains(busqueda) ||
             a.Id_Actividad.ToString().Contains(busqueda))
            &&
            (filtroEvento == "todos" || ObtenerEstado(a) == filtroEstado));

    private string ObtenerEstado(GestionEventosModelo.Entidades.Asistencia a)
    {
        return "";
    }

    private string ObtenerClaseEstado(GestionEventosModelo.Entidades.Asistencia a)
    {
        return ObtenerEstado(a) == "Presente" ? "badge-completado-tabla" : "badge-fallido-tabla";
    }

    //retorna estadisticas
    private int TotalPresentes => listaAsistencias?.Count ?? 0;
    private int TotalAusentes => 0;
    private string TasaAsistencia => listaAsistencias == null || !listaAsistencias.Any()
     ? "0%"
     : $"{Math.Round((double) TotalPresentes / (TotalPresentes + TotalAusentes) * 100)}%";


    protected override async Task OnInitializedAsync()
    {
        fechaHoy = DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy",
                   new System.Globalization.CultureInfo("es-ES"));
        await CargarAsistencias();
    }

    private async Task CargarAsistencias()
    {
        try
        {
            listaAsistencias = await Repository.GetAsync<List<GestionEventosModelo.Entidades.Asistencia>>("api/asistencias");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            listaAsistencias = new List<GestionEventosModelo.Entidades.Asistencia>();
        }
    }
}
