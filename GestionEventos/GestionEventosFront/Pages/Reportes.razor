@* Ruta de esta página *@
@page "/reportes"

@* Permite usar el componente del menú *@
@using GestionEventosFront.Layout
@using GestionEventosModelo.Entidades
@inject NavigationManager Navegacion
@inject GestionEventosFront.Service.SesionServicio Sesion

<div class="pagina-con-menu">

    <MenuOrganizador />

    <div class="contenido-principal">

        @* ---- BARRA SUPERIOR ---- *@
        <div class="barra-superior">
            <span class="barra-fecha">@fechaHoy</span>
            <div class="barra-usuario">
                <span class="barra-nombre">@nombreUsuario</span>
                <span class="barra-email">@emailUsuario</span>
                <div class="barra-avatar">👤</div>
            </div>
        </div>

        <div class="cuerpo-dashboard">

            @* ---- ENCABEZADO ---- *@
            <div class="explorar-header">
                <div>
                    <h1 class="titulo-pagina">Reportes</h1>
                    <p class="subtitulo-pagina">Análisis y datos de todos los eventos</p>
                </div>
                <button class="boton-exportar" @onclick="ExportarTodo">
                    📥 Exportar Todo
                </button>
            </div>

            @* ---- MENSAJE ÉXITO ---- *@
            @if (!string.IsNullOrEmpty(mensajeExito))
            {
                <p class="mensaje-exito">@mensajeExito</p>
            }

            @* ---- TARJETAS DE ESTADÍSTICAS ---- *@
            <div class="tarjetas-estadisticas">

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-azul">📅</div>
                    <div class="estadistica-label-pequeño">Total Eventos</div>
                    <div class="estadistica-numero">@totalEventos</div>
                </div>

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-verde">👥</div>
                    <div class="estadistica-label-pequeño">Inscripciones</div>
                    <div class="estadistica-numero">@totalInscripciones</div>
                </div>

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-morado">✅</div>
                    <div class="estadistica-label-pequeño">Asistencias</div>
                    <div class="estadistica-numero">@totalAsistencias</div>
                </div>

                <div class="tarjeta-estadistica">
                    <div class="estadistica-icono fondo-naranja">🏆</div>
                    <div class="estadistica-label-pequeño">Certificados</div>
                    <div class="estadistica-numero">@totalCertificados</div>
                </div>

            </div>

            @* ---- REPORTE DE ASISTENTES POR EVENTO ---- *@
            <div class="reporte-seccion">
                <div class="reporte-seccion-header">
                    <h2 class="titulo-seccion">Reporte de Asistentes por Evento</h2>
                    <div style="display:flex; gap:8px; align-items:center;">
                        <select class="campo-texto" style="width:auto; padding: 8px 12px; font-size:0.85rem;"
                                @bind="filtroEventoAsistentes">
                            <option value="todos">Todos los eventos</option>
                            <option value="Cumbre de Innovación Digital">Cumbre de Innovación Digital</option>
                            <option value="Conferencia de Tecnología 2026">Conferencia de Tecnología 2026</option>
                        </select>
                        <button class="boton-exportar" style="padding: 8px 16px; font-size:0.82rem;">
                            📥 Exportar
                        </button>
                    </div>
                </div>

                <div class="tabla-contenedor">
                    <table class="tabla-inscripciones">
                        <thead>
                            <tr>
                                <th>ID Asistencia</th>
                                <th>ID Inscripcion</th>
                                <th>ID Actividad</th>
                                <th>Fecha Registro</th>
                                <th>Metodo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listaAsistencias == null)
                            {
                                <tr><td colspan="5">Cargando...</td></tr>
                            }
                            else if (!listaAsistencias.Any())
                            {
                                <tr><td colpsan="5" style="text-align:center">No hay registros</td></tr>
                            }
                            else
                            {
                                @foreach (var a in AsistentesFiltrados)
                                {
                                    <tr>
                                        <td>@a.Id_Asistencia</td>
                                        <td>@a.Id_Inscripcion</td>
                                        <td>@a.Id_Actividad</td>
                                        <td>@a.FechaRegistro</td>
                                        <td>@a.MetodoRegistro</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* ---- ASISTENTES CON PAGO CONFIRMADO ---- *@
            <div class="reporte-seccion">
                <div class="reporte-seccion-header">
                    <h2 class="titulo-seccion">Asistentes con Pago Confirmado</h2>
                    <button class="boton-exportar" style="padding: 8px 16px; font-size:0.82rem;">
                        📥 Exportar
                    </button>
                </div>



                <div class="tabla-contenedor">
                    <table class="tabla-inscripciones">
                        <thead>
                            <tr>
                                <th>ID Inscripcion</th>
                                <th>ID Usuario</th>
                                <th>ID Evento</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!InscripcionesConfirmadas.Any())
                            {
                                <tr><td colspan="5" style="text-align:center;">No hay inscripciones confirmadad</td></tr>
                            }
                            else
                            {
                                @foreach (var ins in InscripcionesConfirmadas)
                                {
                                    <tr>
                                        <td>@ins.Id_Inscripcion</td>
                                        <td>@ins.Id_Usuario</td>
                                        <td>@ins.Id_Evento</td>
                                        <td>@ins.FechaInscripcion.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <span class="badge-tabla badge-completado-tabla">
                                                ✅ @ins.Estado
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* ---- REPORTE POR EVENTO ---- *@
            <div class="reporte-seccion">
                <div class="reporte-seccion-header">
                    <h2 class="titulo-seccion">Reporte por Evento</h2>
                    <button class="boton-exportar" style="padding: 8px 16px; font-size:0.82rem;">
                        📥 Exportar
                    </button>
                </div>

                <div class="tabla-contenedor">
                    <table class="tabla-inscripciones">
                        <thead>
                            <tr>
                                <th>Evento</th>
                                <th>Fecha</th>
                                <th>Lugar</th>
                                <th>Cupo</th>
                                <th>Precio</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listaEventos == null)
                            {
                                <tr><td colspan="6">Cargando...</td></tr>
                            }
                            else if (!listaEventos.Any())
                            {
                                <tr><td colspan="6" style="text-align:center">No hay eventos</td></tr>
                            }
                            else
                            {
                                @foreach (var e in listaEventos)
                                {
                                    <tr>
                                        <td><span class="tabla-nombre">@e.Nombre</span></td>
                                        <td>@e.FechaInicio.ToString("dd/MM/yyyy")</td>
                                        <td>@e.Lugar</td>
                                        <td>@e.CupoTotal</td>
                                        <td>@e.Precio</td>
                                        <td>
                                            <span class="badge-tabla @(e.Estado == "Publicado" ? "badge completado-tabla" : "badge-pendiente-tabla")">
                                                @e.Estado
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* ---- REPORTE DE CERTIFICADOS ---- *@
            <div class="reporte-seccion">
                <div class="reporte-seccion-header">
                    <h2 class="titulo-seccion">Reporte de Certificados</h2>
                    <button class="boton-exportar" style="padding: 8px 16px; font-size:0.82rem;">
                        📥 Exportar
                    </button>
                </div>
                
                <!--<div class="tarjetas-estadisticas" style="grid-template-columns: repeat(3,1fr); margin-bottom:16px;">
                    <div class="tarjeta-estadistica fondo-verde-suave">
                        <div class="estadistica-label-pequeño">Enviados</div>
                        <div class="estadistica-numero">1</div>
                    </div>
                    <div class="tarjeta-estadistica fondo-azul-suave">
                        <div class="estadistica-label-pequeño">Generados</div>
                        <div class="estadistica-numero">1</div>
                    </div>
                    <div class="tarjeta-estadistica fondo-naranja-suave">
                        <div class="estadistica-label-pequeño">Pendientes</div>
                        <div class="estadistica-numero">1</div>
                    </div>
                </div>-->

                <div class="tabla-contenedor">
                    <table class="tabla-inscripciones">
                        <thead>
                            <tr>
                                <th>ID Certificado</th>
                                <th>ID Inscripcion</th>
                                <th>Fecha Generacion</th>
                                <th>Codigo Validacion</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listaCertificados == null)
                            {
                                <tr><td colspan="5">Cargando....</td></tr>
                            }
                            else if (!listaCertificados.Any())
                            {
                                <tr><td colspan="5" style="text-align:center;">No hay certificados</td></tr>
                            }
                            else
                            {
                                @foreach (var c in listaCertificados)
                                {
                                    <tr>
                                        <td>@c.Id_Certificado</td>
                                        <td>@c.Id_Inscripcion</td>
                                        <td>@c.FechaGeneracion.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <span class="badge-tabla badge-generado-tabla">
                                                @c.CodigoValidacion
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge-actividades tabla-contenedor @(string.IsNullOrEmpty(c.UrlPDF) ? "badge-pendiente-tabla" : "badge-completado-tabla")">
                                                @(string.IsNullOrEmpty(c.UrlPDF) ? "Pendiente" : "Enviado")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

    </div>

</div>

@code {

    [Inject] private IRepository Repository { get; set; } = null!;

    private string nombreUsuario = "";
    private string emailUsuario = "";
    private string fechaHoy = "";
    private string mensajeExito = "";
    private string filtroEventoAsistentes = "todos";



    //datos reales de la API
    private List<GestionEventosModelo.Entidades.Evento>? listaEventos;
    private List<GestionEventosModelo.Entidades.Inscripcion>? listaInscripciones;
    private List<GestionEventosModelo.Entidades.Asistencia>? listaAsistencias;
    private List<GestionEventosModelo.Entidades.Certificado>? listaCertificados;

    //estadisticas calculadas
    private int totalEventos => listaEventos?.Count ?? 0;
    private int totalInscripciones => listaInscripciones?.Count ?? 0;
    private int totalAsistencias => listaAsistencias?.Count ?? 0;
    private int totalCertificados => listaCertificados?.Count ?? 0;

    //inscripciones confirmadas
    private IEnumerable<GestionEventosModelo.Entidades.Inscripcion> InscripcionesConfirmadas =>
        (listaInscripciones ?? new List<GestionEventosModelo.Entidades.Inscripcion>())
        .Where(i => i.Estado == "Confirmada");

    private IEnumerable<GestionEventosModelo.Entidades.Asistencia> AsistentesFiltrados =>
        (listaAsistencias ?? new List<GestionEventosModelo.Entidades.Asistencia>())
        .Where(a => filtroEventoAsistentes == "todos" || a.Id_Inscripcion.ToString() == filtroEventoAsistentes);

    protected override async Task OnInitializedAsync()
    {
        nombreUsuario = await Sesion.ObtenerNombre();
        emailUsuario = await Sesion.ObtenerEmail();
        fechaHoy = DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy",
                   new System.Globalization.CultureInfo("es-ES"));
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try{
            listaEventos = await Repository.GetAsync<List<GestionEventosModelo.Entidades.Evento>>("api/eventos");

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error eventos: {ex.Message}");
        }

        try
        {
            listaInscripciones = await Repository.GetAsync<List<GestionEventosModelo.Entidades.Inscripcion>>("api/inscripciones");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error inscripciones: {ex.Message}");
        }

        try
        {
            listaAsistencias = await Repository.GetAsync<List<GestionEventosModelo.Entidades.Asistencia>>("api/asistencias");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error asistencias: {ex.Message}");
        }

        try
        {
            listaCertificados = await Repository.GetAsync<List<GestionEventosModelo.Entidades.Certificado>>("api/certificados");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error certificados: {ex.Message}");
        }
    }

    private void ExportarTodo()
    {
        mensajeExito = "Reporte exportado exitosamente.";
    }
}
