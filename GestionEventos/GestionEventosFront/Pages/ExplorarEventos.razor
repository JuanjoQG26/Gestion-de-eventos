@* Ruta de esta página *@
@page "/explorar-eventos"

@* Permite usar el componente del menú *@
@using GestionEventosFront.Layout

@inject NavigationManager Navegacion

@* ===================== HTML - LO QUE SE VE EN PANTALLA ===================== *@

<div class="pagina-con-menu">

    @* ---- MENÚ LATERAL REUTILIZADO ---- *@
    <MenuAsistente />

    @* ---- CONTENIDO PRINCIPAL ---- *@
    <div class="contenido-principal">

        @* ---- BARRA SUPERIOR ---- *@
        <div class="barra-superior">
            <span class="barra-fecha">@fechaHoy</span>
            <div class="barra-usuario">
                <span class="barra-nombre">Juan</span>
                <span class="barra-email">juan@gmail.com</span>
                <div class="barra-avatar">👤</div>
            </div>
        </div>

        @* ---- CUERPO ---- *@
        <div class="cuerpo-dashboard">

            @* ---- ENCABEZADO CON TÍTULO Y BOTÓN ---- *@
            <div class="explorar-header">
                <div>
                    <h1 class="titulo-pagina">Gestión de Eventos</h1>
                    <p class="subtitulo-pagina">Administra y organiza todos tus eventos</p>
                </div>
            </div>

            @* ---- BARRA DE BÚSQUEDA Y FILTROS ---- *@
            <div class="barra-busqueda-filtros">

                @* Campo de búsqueda: @bind conecta con la variable busqueda *@
                <div class="contenedor-busqueda">
                    <span class="icono-busqueda">🔍</span>
                    <input class="campo-busqueda" type="text"
                           placeholder="Buscar eventos..."
                           @bind="busqueda"
                           @bind:event="oninput" />
                    @* oninput hace que filtre mientras escribe, no solo al salir del campo *@
                </div>

                @* Botones de filtro por estado *@
                <div class="botones-filtro">
                    <button class="boton-filtro @(filtroActivo == "todos" ? "filtro-activo" : "")"
                            @onclick='() => filtroActivo = "todos"'>
                        Todos
                    </button>
                    <button class="boton-filtro @(filtroActivo == "proximo" ? "filtro-activo" : "")"
                            @onclick='() => filtroActivo = "proximo"'>
                        Próximos
                    </button>
                    <button class="boton-filtro @(filtroActivo == "en curso" ? "filtro-activo" : "")"
                            @onclick='() => filtroActivo = "en curso"'>
                        En Curso
                    </button>
                    <button class="boton-filtro @(filtroActivo == "completado" ? "filtro-activo" : "")"
                            @onclick='() => filtroActivo = "completado"'>
                        Completados
                    </button>
                </div>

            </div>

            @* ---- GRID DE TARJETAS DE EVENTOS ---- *@
            @* EventosFiltrados es una propiedad que filtra la lista según búsqueda y filtro *@
            <div class="grid-eventos">
                @if (listaEventos == null)
                {
                    <p class="subtitulo-pagina">Cargando eventos...</p>
                }
                else
                {
                    <div class="grid-eventos">
                        @foreach (var evento in EventosFiltrados)
                        {
                            <div class="tarjeta-evento-explorar">
                                <div class="evento-imagen-contenedor">
                                    <div class="evento-imagen-placeholder">🎪</div>
                                    <span class="badge-estado @(evento.Estado == "Publicado" ? "badge-proximo" : "badge-completado")">
                                        @evento.Estado
                                    </span>
                                </div>
                                <div class="evento-explorar-info">
                                    <h3 class="evento-explorar-nombre">@evento.Nombre</h3>
                                    <p class="evento-explorar-desc">@evento.Descripcion</p>
                                    <div class="evento-explorar-detalles">
                                        <span>📅 @evento.FechaInicio.ToString("dd/MM/yyyy")</span>
                                        <span>📍 @evento.Lugar</span>
                                        <span class="evento-precio">💲 $@evento.Precio</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @* Si no hay eventos que coincidan con la búsqueda *@
            @if (!EventosFiltrados.Any())
            {
                <div class="sin-resultados">
                    <p>😕 No se encontraron eventos con ese criterio.</p>
                </div>
            }

        </div>
        @* fin cuerpo-dashboard *@

    </div>
    @* fin contenido-principal *@

</div>

@* ===================== C# - LA LÓGICA ===================== *@
@code {



    [Inject] private IRepository Repository { get; set; } = null!;

    private string fechaHoy = "";
    private string busqueda = "";
    private string filtroActivo = "todos";

    private List<GestionEventosModelo.Entidades.Evento>? listaEventos;

    private IEnumerable<Evento> EventosFiltrados => (listaEventos ?? new List<Evento>())
        .Where(e =>
            (string.IsNullOrEmpty(busqueda) || 
            e.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
            e.Lugar.Contains(busqueda, StringComparison.OrdinalIgnoreCase))
            &&
            (filtroActivo == "todos" || e.Estado.ToLower() == filtroActivo));

    protected override async Task OnInitializedAsync()
    {
        fechaHoy = DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy",
            new System.Globalization.CultureInfo("es-ES"));

        try
        {
            listaEventos = await Repository.GetAsync<List<Evento>>("api/eventos");
        }
        catch
        {
            listaEventos = new List<Evento>();
        }
    }

    
}
