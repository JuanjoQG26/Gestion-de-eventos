@* Ruta de esta página *@
@page "/explorar-eventos"

@* Permite usar el componente del menú *@
@using GestionEventosFront.Layout

@inject NavigationManager Navegacion

@* ===================== HTML - LO QUE SE VE EN PANTALLA ===================== *@

<div class="pagina-con-menu">

    @* ---- MENÚ LATERAL REUTILIZADO ---- *@
    <MenuAsistente />

    @* ---- CONTENIDO PRINCIPAL ---- *@
    <div class="contenido-principal">

        @* ---- BARRA SUPERIOR ---- *@
        <div class="barra-superior">
            <span class="barra-fecha">@fechaHoy</span>
            <div class="barra-usuario">
                <span class="barra-nombre">Juan</span>
                <span class="barra-email">juan@gmail.com</span>
                <div class="barra-avatar">👤</div>
            </div>
        </div>

        @* ---- CUERPO ---- *@
        <div class="cuerpo-dashboard">

            @* ---- ENCABEZADO CON TÍTULO Y BOTÓN ---- *@
            <div class="explorar-header">
                <div>
                    <h1 class="titulo-pagina">Gestión de Eventos</h1>
                    <p class="subtitulo-pagina">Administra y organiza todos tus eventos</p>
                </div>
            </div>

            @* ---- BARRA DE BÚSQUEDA Y FILTROS ---- *@
            <div class="barra-busqueda-filtros">

                @* Campo de búsqueda: @bind conecta con la variable busqueda *@
                <div class="contenedor-busqueda">
                    <span class="icono-busqueda">🔍</span>
                    <input class="campo-busqueda" type="text"
                           placeholder="Buscar eventos..."
                           @bind="busqueda"
                           @bind:event="oninput" />
                    @* oninput hace que filtre mientras escribe, no solo al salir del campo *@
                </div>

                @* Botones de filtro por estado *@
                <div class="botones-filtro">
                    <button class="boton-filtro @(filtroActivo == "todos" ? "filtro-activo" : "")"
                            @onclick='() => filtroActivo = "todos"'>
                        Todos
                    </button>
                    <button class="boton-filtro @(filtroActivo == "proximo" ? "filtro-activo" : "")"
                            @onclick='() => filtroActivo = "proximo"'>
                        Próximos
                    </button>
                    <button class="boton-filtro @(filtroActivo == "en curso" ? "filtro-activo" : "")"
                            @onclick='() => filtroActivo = "en curso"'>
                        En Curso
                    </button>
                    <button class="boton-filtro @(filtroActivo == "completado" ? "filtro-activo" : "")"
                            @onclick='() => filtroActivo = "completado"'>
                        Completados
                    </button>
                </div>

            </div>

            @* ---- GRID DE TARJETAS DE EVENTOS ---- *@
            @* EventosFiltrados es una propiedad que filtra la lista según búsqueda y filtro *@
            <div class="grid-eventos">
                @foreach (var evento in EventosFiltrados)
                {
                    @* Por cada evento en la lista genera una tarjeta *@
                    <div class="tarjeta-evento-explorar">

                        @* Imagen del evento con badge de estado encima *@
                        <div class="evento-imagen-contenedor">
                            <div class="evento-imagen-placeholder">🎪</div>
                            <span class="badge-estado @evento.EstadoClase">@evento.Estado</span>
                        </div>

                        @* Información del evento *@
                        <div class="evento-explorar-info">
                            <h3 class="evento-explorar-nombre">@evento.Nombre</h3>
                            <p class="evento-explorar-desc">@evento.Descripcion</p>

                            <div class="evento-explorar-detalles">
                                <span>📅 @evento.Fecha</span>
                                <span>📍 @evento.Lugar</span>
                                <span>👥 @evento.Inscritos / @evento.CupoTotal inscritos</span>
                                <span class="evento-precio">💲 $@evento.Precio</span>
                            </div>

                            @* Barra de ocupación *@
                            <div class="barra-ocupacion-contenedor">
                                <span class="ocupacion-texto">Ocupación</span>
                                <span class="ocupacion-porcentaje">@evento.Ocupacion%</span>
                            </div>
                            <div class="barra-ocupacion">
                                @* El ancho de la barra cambia según el porcentaje *@
                                <div class="barra-ocupacion-progreso"
                                     style="width: @evento.Ocupacion%"></div>
                            </div>

                        </div>
                    </div>
                }
            </div>

            @* Si no hay eventos que coincidan con la búsqueda *@
            @if (!EventosFiltrados.Any())
            {
                <div class="sin-resultados">
                    <p>😕 No se encontraron eventos con ese criterio.</p>
                </div>
            }

        </div>
        @* fin cuerpo-dashboard *@

    </div>
    @* fin contenido-principal *@

</div>

@* ===================== C# - LA LÓGICA ===================== *@
@code {

    // Variable que guarda la fecha de hoy
    private string fechaHoy = "";

    // Variable que guarda lo que el usuario escribe en la búsqueda
    private string busqueda = "";

    // Variable que guarda el filtro activo: "todos", "proximo", "en curso", "completado"
    private string filtroActivo = "todos";

    // Clase que representa un evento con todos sus datos
    private class Evento
    {
        public string Nombre { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public string Fecha { get; set; } = "";
        public string Lugar { get; set; } = "";
        public int Inscritos { get; set; }
        public int CupoTotal { get; set; }
        public string Precio { get; set; } = "";
        public string Estado { get; set; } = "";
        // EstadoClase es el nombre de la clase CSS según el estado
        public string EstadoClase { get; set; } = "";
        // Ocupacion calcula el porcentaje de inscritos sobre cupo total
        public int Ocupacion => (int)((double)Inscritos / CupoTotal * 100);
    }

    // Lista de eventos de ejemplo (cuando tengamos el back vendrán de la base de datos)
    private List<Evento> listaEventos = new List<Evento>
    {
        new Evento { Nombre = "Conferencia de Tecnología 2026", Descripcion = "El evento más importante de tecnología del año con expertos internacionales", Fecha = "14 de abril de 2026", Lugar = "Centro de Convenciones Internacional", Inscritos = 387, CupoTotal = 500, Precio = "150", Estado = "Próximo", EstadoClase = "badge-proximo" },
        new Evento { Nombre = "Cumbre de Innovación Digital", Descripcion = "Explorando las últimas tendencias en transformación digital", Fecha = "9 de marzo de 2026", Lugar = "Hotel Grand Palace", Inscritos = 245, CupoTotal = 300, Precio = "200", Estado = "En Curso", EstadoClase = "badge-en-curso" },
        new Evento { Nombre = "Foro de Emprendimiento", Descripcion = "Conectando startups con inversionistas", Fecha = "19 de febrero de 2026", Lugar = "Centro Empresarial", Inscritos = 200, CupoTotal = 200, Precio = "100", Estado = "Completado", EstadoClase = "badge-completado" },
        new Evento { Nombre = "Taller de Inteligencia Artificial", Descripcion = "Aprende los fundamentos de IA con expertos del sector", Fecha = "20 de mayo de 2026", Lugar = "ITM Medellín", Inscritos = 80, CupoTotal = 150, Precio = "50", Estado = "Próximo", EstadoClase = "badge-proximo" },
    };

    // Propiedad que filtra la lista según búsqueda y filtro activo
    // Se recalcula automáticamente cada vez que cambia busqueda o filtroActivo
    private IEnumerable<Evento> EventosFiltrados => listaEventos
        .Where(e =>
            // Filtra por texto de búsqueda (nombre o lugar)
            (string.IsNullOrEmpty(busqueda) ||
             e.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
             e.Lugar.Contains(busqueda, StringComparison.OrdinalIgnoreCase))
            &&
            // Filtra por estado
            (filtroActivo == "todos" ||
             e.Estado.ToLower() == filtroActivo));

    // OnInitialized se ejecuta cuando la página carga
    protected override void OnInitialized()
    {
        fechaHoy = DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy",
                   new System.Globalization.CultureInfo("es-ES"));
    }
}
